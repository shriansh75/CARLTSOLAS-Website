# source material + large masters (used to derive the site; not part of the build)
/*.mp4
/*.png
/*.pdf
/*.pptx

# CONFIDENTIAL working documents. Inspection reports and client records carry
# vessel, commercial and crew personal data (passport and seaman's-book numbers,
# dates of birth, certificates of competency). They are reference material only
# and must never reach this public repository.
/*.docx
/*.doc
/*.xlsx
/*.xls
/confidential/

# Crash dumps from the MSYS/Git Bash toolchain. Local noise, never source.
*.stackdump
